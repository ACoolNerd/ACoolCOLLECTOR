# ACoolCOLLECTOR — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env, .env.local, or any file with real values.
# Store secrets in macOS Keychain, not in files.

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── External Data Providers ──────────────────────────────
# Keys live in macOS Keychain. Inject at startup only.
# Key names are listed here for documentation only.
SPORTSCARDSPRO_API_KEY=
PRICECHARTING_BASE_URL=

# ── AI / OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=

# ── Next.js Public ───────────────────────────────────────
# NEXT_PUBLIC_ prefix means these ARE bundled into the browser.
# Do NOT put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Docker ───────────────────────────────────────────────
DOCKER_SOCK=/var/run/docker.sock
